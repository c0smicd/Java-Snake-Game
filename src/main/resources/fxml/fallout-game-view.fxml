<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="704.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cosmic.snakegamecraft.controller.FalloutGameModeController">

    <top>
        <HBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <AnchorPane fx:id="rootPane">
            <Canvas fx:id="gameCanvas" height="704.0" width="640" />
            <Label fx:id="scoreLabel" layoutX="14.0" layoutY="654.0" text="Score: 0" textFill="WHITE" textOverrun="CLIP">
                <font>
                    <Font name="Lucida Console" size="25.0" />
                </font></Label>
         <ProgressBar fx:id="radiationBar" layoutX="40.0" layoutY="14.0" prefHeight="18.0" prefWidth="560.0" progress="0.0" />
        </AnchorPane>
    </center>

</BorderPane>
