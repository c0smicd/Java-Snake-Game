<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cosmic.snakegamecraft.controller.ModernGameModeController"
            prefHeight="704.0" prefWidth="640.0">

    <top>
        <HBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <AnchorPane>
            <Canvas fx:id="gameCanvas" height="704.0" width="640" />
            <Label fx:id="scoreLabel" layoutX="14.0" layoutY="654.0" text="Score: 0" textFill="WHITE" textOverrun="CLIP">
                <font>
                    <Font name="Lucida Console" size="25.0" />
                </font></Label>
        </AnchorPane>
    </center>

</BorderPane>
